# Copia este archivo a ".env" (mismo nombre, sin ".example") en la misma
# carpeta, y rellena los valores.

# URL base de tu app de Vantax en Render (sin barra al final).
VANTAX_API_BASE=https://vantax-app.onrender.com

# Tiene que ser EXACTAMENTE el mismo valor que la variable de entorno
# MT5_ORCHESTRATOR_SECRET que configures en Render. Generalo con algo como:
# openssl rand -hex 32   (en Linux/Mac)
# o simplemente una contraseña larga y aleatoria - guardala bien, es la
# llave que deja leer y escribir datos de cuentas.
VANTAX_MT5_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Ruta completa al terminal64.exe del MetaTrader 5 instalado en esta VPS.
TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Cada cuantos segundos se repite el ciclo de sincronizacion. 900 = 15 min.
SYNC_INTERVAL_SECONDS=900
